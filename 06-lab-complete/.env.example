# ============================================================
# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# Trên Railway/Render: đặt các biến này trong dashboard của service.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bảo mật — sinh key ngẫu nhiên: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me-to-a-long-random-string

# Redis (rate limit + cost guard). Trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
